{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/sw.js",
      "cacheControl": "no-cache"
    },
    {
      "source": "/assets/(.*)",
      "cacheControl": "public, max-age=86400"
    }
  ]
}
